# VEX-OS Environment Configuration
# Copy to .env and populate with real values.
# NEVER commit .env to version control — it is listed in .gitignore and
# blocked by the pre-commit hook (see .husky/pre-commit).

# ── Application ──────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# apps/web reads this (must be NEXT_PUBLIC_* to reach client components).
# Same value as API_URL above in local dev.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Comma-separated browser origins allowed to call apps/api cross-origin
# (SEC-001 §4: "Strict CORS origin whitelist; no wildcard origins in
# production" - see middleware/cors.ts). Defaults to APP_URL if unset;
# only needs multiple values when a second real origin (e.g. a staging
# domain) also calls this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# JWT_REFRESH_SECRET / SESSION_SECRET are reserved for the custom
# POST /api/v1/auth/refresh flow (SEC-001 §3.1's refresh-token revocation
# table already exists in packages/database) - not yet implemented, out of
# Sprint 1 scope. Not to be confused with AUTH_SECRET below, which NextAuth
# v5 needs today for its own session cookie encryption.
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
# RS256 keypair for JWT signing (SEC-001 §3.1). Generate locally with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -pubout -in jwt_private.pem -out jwt_public.pem
# Paste PEM contents below with \n escaped, or point at a file path via your
# secrets manager in production. Addition beyond the VEX-OS-API-001 §5
# template — see DL-SEC-001 in the Decision Log for rationale. apps/web's
# auth.ts (issuer) signs with JWT_PRIVATE_KEY; apps/api's JWT middleware
# (verifier) checks with JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Auth (NextAuth v5) ────────────────────────
# Encrypts NextAuth's own session cookie - distinct from the JWT_* keypair
# above. Generate with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Shared secret for apps/web -> apps/api service-to-service calls (currently
# just GET /api/v1/internal/resolve-role, called from auth.ts's NextAuth jwt
# callback to decide whether a new session is an Executive, Delegate, or
# Administrator - see resolve-role-for-email.ts). Not a user-facing
# credential; generate with: openssl rand -base64 33
INTERNAL_API_SECRET=
# Comma-separated allowlist of emails that sign in with the Administrator
# role (system config, audit log export, user role management - SEC-001
# §3.2; no access to executive content). Checked in resolveRoleForEmail
# ahead of the Executive/Delegate lookups. Nothing in-product can grant
# this role - see DL-SEC-002 in the Decision Log. Leave empty in
# environments that don't need an Administrator yet.
ADMIN_EMAILS=

# ── Database ─────────────────────────────────
# Local dev via docker-compose: postgresql://vexos:vexos_local_dev@localhost:5432/vexos
DATABASE_URL=
DB_ENCRYPTION_KEY=

# ── Cache / Queue ────────────────────────────
# Local dev via docker-compose: redis://localhost:6379
REDIS_URL=

# ── AI Provider ──────────────────────────────
LLM_PROVIDER=anthropic
LLM_PROVIDER_SECONDARY=
LLM_MODEL_DEFAULT=claude-sonnet-4-6
LLM_MODEL_ANALYSIS=claude-opus-4-6
LLM_MODEL_ONBOARDING=claude-sonnet-4-6
LLM_MODEL_DRAFT=claude-haiku-4-5-20251001
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# ── Google Integration ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Microsoft Integration ────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=common

# ── Slack Integration ────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ── Storage ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Monitoring ───────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=
